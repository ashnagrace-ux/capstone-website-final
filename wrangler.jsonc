{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uc-capstone",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "uc-capstone",
    "database_id": "8bb3bdc3-94c1-4276-b2b4-19a7315b8a16",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "uc-capstone-documents" }]
}
